{
  "name": "dsh-collab",
  "version": "0.3.3",
  "description": "Multi-agent real-time collaboration & concurrency lock plugin for DSH",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/collab.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/collab.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/types lib/",
    "prepack": "npm run build",
    "test": "npm run build && node tests/collab-pure-logic.mjs && node tests/collab-integration.mjs",
    "test:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dsh",
    "cordis",
    "multi-agent",
    "collaboration",
    "advisory-lock"
  ],
  "author": "",
  "license": "MIT"
}
